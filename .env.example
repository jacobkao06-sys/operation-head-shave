# SPEC.md §10. Nothing here is ever exposed to the client.
# Copy to .env.local for development. NEVER put real addresses in this file.

# --- App ---
PUBLIC_URL=https://shave.jacobkao.com
PROTOCOL_URL=https://protocol.jacobkao.com
TZ_DISPLAY=America/New_York
FAILURE_THRESHOLD_HOURS=168
COUNTDOWN_HOURS=72
DRY_RUN=true

# --- Instagram ---
IG_APP_ID=
IG_APP_SECRET=
IG_API_VERSION=v23.0
IG_MEDIA_TYPES=IMAGE,VIDEO,CAROUSEL_ALBUM,REELS
# The access token and its expiry live in KV, not here.

# --- Mock source (development only) ---
USE_MOCK_SOURCE=false
MOCK_LAST_POST_AT=-2d

# --- Storage ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=

# --- Email ---
RESEND_API_KEY=
MAIL_FROM=protocol@mail.jacobkao.com
JACOB_EMAIL=
ANDREA_EMAIL=
BARBER_EMAIL=<set BARBER_EMAIL in the host env — never here, see §13>
BARBER_MODE=draft
BARBER_CONFIRM_PHRASE=

# --- Vision ---
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5
VISION_MIN_CONFIDENCE=0.7

# --- Auth ---
CRON_SECRET=
ADMIN_TOKEN=
